# Copy to .env.local and fill in, or paste values in the in-app setup overlay.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: LiveKit Cloud project for voice chat (ws:// region url from LiveKit dashboard)
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Optional: Sentry project DSN for error monitoring (leave empty to disable)
VITE_SENTRY_DSN=https://key@o0.ingest.sentry.io/0
